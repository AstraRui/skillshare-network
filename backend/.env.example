SSN_ENVIRONMENT=local
SSN_SECRET_KEY=change-me-in-production
SSN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillshare
SSN_REDIS_URL=redis://localhost:6379/0

# Логирование (logs/ в .gitignore)
SSN_LOG_LEVEL=INFO
SSN_LOG_DIR=logs
SSN_LOG_FILE=app.log
SSN_LOG_MAX_BYTES=10485760
SSN_LOG_BACKUP_COUNT=5
